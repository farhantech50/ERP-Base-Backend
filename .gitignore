# Dependency directories
node_modules/
jspm_packages/

# Prisma specific
/prisma/migrations/**/*.sql
# Un-comment the line below if you want to ignore migrations entirely (not recommended for teams)
# /prisma/migrations/

# Build and compilation outputs
dist/
build/
out/
lib/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented code coverage downloads
coverage
.nyc_output

# Next.js/Nuxt.js build tool cache (if applicable)
.next/
.nuxt/

# IDEs and text editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Operating System files
.DS_Store
Thumbs.db
Desktop.ini
